# BONJOUR IA — Audio Intelligence Workspace
# Copiez ce fichier en .env puis adaptez les valeurs.
# Les réglages modifiés depuis la page « Paramètres » sont prioritaires sur ce fichier.

# Serveur local (ne jamais exposer sur 0.0.0.0 : l'application est prévue pour un usage local)
APP_HOST=127.0.0.1
APP_PORT=8765

# Dossier des données (audios, base SQLite, exports, modèles).
# À placer HORS de OneDrive / Dropbox / Google Drive pour que rien ne soit synchronisé dans le cloud.
DATA_DIR=C:\TranscripIA-data

# Exécutables (laisser vide pour une détection automatique)
FFMPEG_PATH=
FFPROBE_PATH=

# Whisper (faster-whisper)
# Profil : rapide (base, ~2 min pour 45 min), equilibre (small, ~6 min), precis (small beam 5, ~16 min), perso
WHISPER_PROFILE=equilibre
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=1
CHUNK_DURATION_SEC=300

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=2048

# Audio
MAX_UPLOAD_MB=2048

# Jobs
JOB_TIMEOUT_MIN=720
JOB_RETRIES=1

# Journalisation : DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
